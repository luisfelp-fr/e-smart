# MODELO — copie para .streamlit/secrets.toml e preencha.
#
# O arquivo real NUNCA vai para o Git (está no .gitignore). Se algum dia ele
# for commitado por engano, não basta apagar: o segredo fica no histórico e
# precisa ser ROTACIONADO no provedor de identidade.
#
# No Streamlit Community Cloud não se usa este arquivo: cole o mesmo conteúdo
# em Settings > Secrets, na interface do app.
#
# Requer streamlit >= 1.42 (login nativo via OIDC). Ative com st.login().

[auth]
# Para onde o provedor devolve o usuário depois do login.
# Local:   http://localhost:8501/oauth2callback
# Publicado: https://SEU-APP/oauth2callback  (tem de bater EXATAMENTE com o
#            que estiver cadastrado no provedor, inclusive https e barra)
redirect_uri = "http://localhost:8501/oauth2callback"

# Assina o cookie de sessão. String longa e aleatória, própria de cada
# ambiente — NÃO reaproveite a de outro app. Gere com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "TROQUE-POR-UMA-STRING-ALEATORIA-LONGA"


# --- Microsoft Entra ID (Azure AD) — caso corporativo mais comum -----------
[auth.microsoft]
client_id = "PREENCHER"
client_secret = "PREENCHER"
# Troque {tenant} pelo ID do diretório da empresa. Usar o tenant específico
# (e não "common") é o que restringe o login a quem é da organização.
server_metadata_url = "https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration"


# --- Google Workspace — alternativa ---------------------------------------
# [auth.google]
# client_id = "PREENCHER"
# client_secret = "PREENCHER"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


# Lembrete: isto responde "QUEM ENTRA no app". Não responde "ONDE O DADO
# REPOUSA" — as planilhas enviadas continuam gravadas no disco de quem
# hospeda o app. Restringir o login não muda a jurisdição nem o dono da
# infraestrutura onde o dado fica; isso é decisão de hospedagem.
